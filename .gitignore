# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example

# OS / editor junk
.DS_Store
*.swp

# Node
node_modules/

# Secrets & keys — NEVER commit
*.key
*.pem
secrets/
/etc/

# Live production config (contains the keyed dRPC endpoint; generated by deploy-mainnet.sh)
indexer/config.production.json

# Runtime ledger data — deterministically regenerated by the indexer from chain
indexer/state.json
indexer/events.jsonl
indexer/*.corrupt
indexer/oracle.heartbeat
indexer/backups/

# Testnet + demo runtime artifacts (regenerated; not source)
indexer/testnet-state.json
indexer/testnet-events.jsonl
indexer/state.testnet.json
indexer/events.testnet.jsonl
indexer/config.testnet.json
demo/state.json
demo/events.jsonl

# Launchpad (foundry) deploy logs — regenerable; addresses live in launchpad/README.md
launchpad/broadcast/
